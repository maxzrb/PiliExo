@@ -0,0 +1,57 @@
+#ifndef PILIEXO_AUDIO_CLOCK_H
+#define PILIEXO_AUDIO_CLOCK_H
+
+#define PILIEXO_AUDIO_RATE_HISTORY 64
+
+struct piliexo_audio_clock {
+    struct {
+        double duration;
+        double rate;
+    } runs[PILIEXO_AUDIO_RATE_HISTORY];
+    unsigned next;
+    unsigned count;
+};
+
+static inline void piliexo_audio_clock_reset(struct piliexo_audio_clock *clock)
+{
+    clock->next = 0;
+    clock->count = 0;
+}
+
+static inline void piliexo_audio_clock_write(struct piliexo_audio_clock *clock,
+                                            double duration, double rate)
+{
+    if (!(duration > 0) || !__builtin_isfinite(duration) ||
+        !(rate > 0) || !__builtin_isfinite(rate))
+        return;
+    unsigned last = (clock->next + PILIEXO_AUDIO_RATE_HISTORY - 1) %
+                    PILIEXO_AUDIO_RATE_HISTORY;
+    if (clock->count && clock->runs[last].rate == rate) {
+        clock->runs[last].duration += duration;
+        return;
+    }
+    clock->runs[clock->next].duration = duration;
+    clock->runs[clock->next].rate = rate;
+    clock->next = (clock->next + 1) % PILIEXO_AUDIO_RATE_HISTORY;
+    if (clock->count < PILIEXO_AUDIO_RATE_HISTORY)
+        clock->count++;
+}
+
+static inline double piliexo_audio_clock_delay(const struct piliexo_audio_clock *clock,
+                                               double delay, double current_rate)
+{
+    double media_delay = 0;
+    unsigned slot = clock->next;
+    // 从最新一段向前，把设备仍排队的物理时长按各段的处理倍速换算。
+    for (unsigned i = 0; i < clock->count && delay > 0; i++) {
+        slot = (slot + PILIEXO_AUDIO_RATE_HISTORY - 1) % PILIEXO_AUDIO_RATE_HISTORY;
+        double duration = clock->runs[slot].duration;
+        double queued = delay < duration ? delay : duration;
+        media_delay += queued * clock->runs[slot].rate;
+        delay -= queued;
+    }
+    // 输出设备估算的延迟可能包含尚无时间戳的部分，沿用原估算。
+    return media_delay + delay * current_rate;
+}
+
+#endif
