+static void refresh_mov_index_for_backward_seek(demuxer_t *demuxer, int64_t target)
+{
+    lavf_priv_t *priv = demuxer->priv;
+    AVFormatContext *previous = priv->avfc;
+    if (!priv->opts->piliexo_refresh_mov_index ||
+        priv->highest_packet_dts == AV_NOPTS_VALUE ||
+        target >= priv->highest_packet_dts || !priv->pb ||
+        !(priv->pb->seekable & AVIO_SEEKABLE_NORMAL) ||
+        previous->nb_streams != 1 || priv->pcm_seek_hack || priv->num_nested ||
+        !matches_avinputformat_name(priv, "mov"))
+        return;
+
+    // 单轨分片回跳时丢弃此前的索引，复用当前 AVIO 与 mpv 的轨道和输出。
+    // 只使用 FFmpeg 公共接口，不读取 MOV 解封装器的私有索引。
+    AVFormatContext *next = avformat_alloc_context();
+    if (!next)
+        return;
+    AVDictionary *options = NULL;
+    int64_t previous_offset = avio_tell(priv->pb);
+    if (av_dict_copy(&options, priv->av_opts, 0) < 0 ||
+        avio_seek(priv->pb, 0, SEEK_SET) != 0)
+        goto done;
+
+    next->pb = priv->pb;
+    next->flags = previous->flags | AVFMT_FLAG_CUSTOM_IO;
+    next->interrupt_callback = previous->interrupt_callback;
+    next->opaque = previous->opaque;
+    next->io_open = block_io_open;
+    if (avformat_open_input(&next, priv->filename, priv->avif, &options) < 0 ||
+        next->nb_streams != 1)
+        goto done;
+
+    AVStream *old_stream = previous->streams[0];
+    AVStream *new_stream = next->streams[0];
+    if (new_stream->id != old_stream->id ||
+        new_stream->codecpar->codec_id != old_stream->codecpar->codec_id ||
+        av_cmp_q(new_stream->time_base, old_stream->time_base))
+        goto done;
+
+    new_stream->discard = old_stream->discard;
+    priv->avfc = next;
+    priv->highest_packet_dts = AV_NOPTS_VALUE;
+    avformat_close_input(&previous);
+    av_dict_free(&options);
+    MP_VERBOSE(demuxer, "PiliExo refreshed MOV index for backward seek\n");
+    return;
+
+done:
+    avformat_close_input(&next);
+    av_dict_free(&options);
+    if (previous_offset >= 0)
+        avio_seek(priv->pb, previous_offset, SEEK_SET);
+}
