+static int seek_fade_frames(struct ao *ao)
+{
+    return MPMAX(1, ao->samplerate / 200);
+}
+
+#define FADE_PLANE(type, center)                                                \
+    for (int frame = 0; frame < frames; frame++) {                              \
+        double gain = (double)(total - remaining + frame) / total;               \
+        for (int channel = 0; channel < channels; channel++) {                 \
+            type *sample = &((type *)data[plane])[frame * channels + channel];  \
+            *sample = (type)(((double)*sample - (center)) * gain + (center));  \
+        }                                                                      \
+    }
+
+static void fade_in_after_seek(struct ao *ao, void **data, int samples)
+{
+    struct buffer_state *p = ao->buffer_state;
+    const int remaining = p->seek_fade_remaining;
+    if (!remaining || !samples)
+        return;
+
+    // 缓冲期间填充的静音不消耗淡入长度。
+    const int total = seek_fade_frames(ao);
+    const int frames = MPMIN(samples, remaining);
+    const int channels = ao->channels.num / ao->num_planes;
+    const int format = af_fmt_from_planar(ao->format);
+    for (int plane = 0; plane < ao->num_planes; plane++) {
+        switch (format) {
+        case AF_FORMAT_U8:     FADE_PLANE(uint8_t, 128); break;
+        case AF_FORMAT_S16:    FADE_PLANE(int16_t, 0); break;
+        case AF_FORMAT_S32:    FADE_PLANE(int32_t, 0); break;
+        case AF_FORMAT_FLOAT:  FADE_PLANE(float, 0); break;
+        case AF_FORMAT_DOUBLE: FADE_PLANE(double, 0); break;
+        }
+    }
+    p->seek_fade_remaining -= frames;
+}
+
+#undef FADE_PLANE
+
+#define BLEND_TAIL(type, center, low, high)                                    \
+    for (int channel = 0; channel < channels; channel++) {                     \
+        type *pcm = data;                                                      \
+        for (int frame = 0; frame < blend_frames; frame++) {                   \
+            double gain = (double)(remaining - frame) / total;                 \
+            int index = frame * channels + channel;                            \
+            double mixed = pcm[index] + p->seek_tail[channel] * gain;          \
+            pcm[index] = (type)MPCLAMP(mixed, low, high);                        \
+        }                                                                      \
+        p->last_samples[channel] = (double)pcm[(samples - 1) * channels + channel] -\
+                                   (center);                                   \
+    }
+
+static void blend_seek_tail(struct ao *ao, void *data, int samples)
+{
+    struct buffer_state *p = ao->buffer_state;
+    const int total = seek_fade_frames(ao);
+    const int remaining = p->seek_tail_remaining;
+    const int blend_frames = MPMIN(samples, remaining);
+
+    // 上一块已入队的尾样本接到当前音频或静音，避免直接截断波形。
+    const int channels = ao->channels.num;
+    switch (ao->format) {
+    case AF_FORMAT_U8:    BLEND_TAIL(uint8_t, 128, 0, UINT8_MAX); break;
+    case AF_FORMAT_S16:   BLEND_TAIL(int16_t, 0, INT16_MIN, INT16_MAX); break;
+    case AF_FORMAT_S32:   BLEND_TAIL(int32_t, 0, INT32_MIN, INT32_MAX); break;
+    case AF_FORMAT_FLOAT: BLEND_TAIL(float, 0, -FLT_MAX, FLT_MAX); break;
+    }
+    p->seek_tail_remaining -= blend_frames;
+}
+
+#undef BLEND_TAIL
