@@ -0,0 +1,16 @@
+#ifndef MPV_PILIEXO_CODEC_RATE_H
+#define MPV_PILIEXO_CODEC_RATE_H
+
+#include <math.h>
+
+// 提示解码器预留吞吐；用户选择的实际播放倍率由播放时钟控制。
+static inline int piliexo_codec_operating_rate(double fps, double speed)
+{
+    if (!(fps > 0 && fps <= 240 && isfinite(speed) && speed > 0))
+        return 0;
+    double demand = fps * fmax(1, speed);
+    int rate = (int)ceil(fmin(24000, demand));
+    return speed > 1.01 ? rate : -rate;
+}
+
+#endif
