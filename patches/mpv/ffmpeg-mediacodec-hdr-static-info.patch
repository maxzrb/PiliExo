diff --git a/libavcodec/mediacodec_hdr.h b/libavcodec/mediacodec_hdr.h
new file mode 100644
--- /dev/null
+++ b/libavcodec/mediacodec_hdr.h
@@ -0,0 +1,51 @@
+#ifndef AVCODEC_MEDIACODEC_HDR_H
+#define AVCODEC_MEDIACODEC_HDR_H
+
+#include "libavutil/frame.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mastering_display_metadata.h"
+#include "libavutil/error.h"
+
+// Android hdr-static-info 为 25 字节 CTA-861.3 Type 1，小端；亮度单位与 EGL 不同。
+static inline int ff_mediacodec_hdr_static_info_to_frame(AVFrame *frame,
+                                                       const uint8_t *data,
+                                                       size_t size)
+{
+    if (!data || size != 25 || data[0] != 0)
+        return 0;
+    unsigned v[12];
+    for (int i = 0; i < 12; i++) v[i] = AV_RL16(data + 1 + 2*i);
+    int has_primaries = 1;
+    for (int i = 0; i < 8; i += 2)
+        has_primaries &= v[i+1] > 0 && v[i] + v[i+1] <= 50000;
+    int has_luminance = v[8] > 0 && v[8] * 10000U >= v[9];
+    if ((has_primaries || has_luminance) &&
+        !av_frame_get_side_data(frame, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA)) {
+        AVMasteringDisplayMetadata *m = av_mastering_display_metadata_create_side_data(frame);
+        if (!m) return AVERROR(ENOMEM);
+        if (has_primaries) {
+            for (int c = 0; c < 3; c++) {
+                m->display_primaries[c][0] = (AVRational){ v[2*c], 50000 };
+                m->display_primaries[c][1] = (AVRational){ v[2*c+1], 50000 };
+            }
+            m->white_point[0] = (AVRational){ v[6], 50000 };
+            m->white_point[1] = (AVRational){ v[7], 50000 };
+            m->has_primaries = 1;
+        }
+        if (has_luminance) {
+            m->max_luminance = (AVRational){ v[8], 1 };
+            m->min_luminance = (AVRational){ v[9], 10000 };
+            m->has_luminance = 1;
+        }
+    }
+    if ((v[10] || v[11]) &&
+        !av_frame_get_side_data(frame, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL)) {
+        AVContentLightMetadata *cl = av_content_light_metadata_create_side_data(frame);
+        if (!cl) return AVERROR(ENOMEM);
+        cl->MaxCLL = v[10];
+        cl->MaxFALL = v[11];
+    }
+    return 0;
+}
+
+#endif
