+// 独立的采样率策略便于回归检查；设备能力不足时不把请求值当成实际输出。
+static bool piliexo_audiotrack_fast_path(int rate, int channels, bool adaptive, bool pcm)
+{
+    return pcm && channels <= 2 && (!adaptive || rate <= 48000);
+}
+
+static int piliexo_audiotrack_rate(int requested, int native_rate,
+                                  bool adaptive, bool pcm, bool fast_capable)
+{
+    if (native_rate <= 0)
+        return requested;
+    if (!adaptive)
+        return requested < native_rate ? requested : native_rate;
+    // 高采样率与直通不受低延迟目标采样率约束。
+    if (!pcm || requested > 48000)
+        return requested;
+    if (fast_capable && native_rate <= 48000)
+        return native_rate;
+    return requested;
 }
 
