+#if HAVE_ANDROID
+static bool use_live_decoder_framedrop(struct MPContext *mpctx, struct vo_chain *vo_c)
+{
+    return (mpctx->opts->frame_dropping & 2) &&
+           strcmp(vo_c->vo->driver->name, "mediacodec_embed") == 0 &&
