+++ b/player/piliexo_late_drop.h
@@ -0,0 +1,81 @@
+#ifndef MPV_PILIEXO_LATE_DROP_H
+#define MPV_PILIEXO_LATE_DROP_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define PILIEXO_RELEASE_NS INT64_C(250000000)
+#define PILIEXO_VO_RECOVERY_MAX_NS INT64_C(3000000000)
+
+struct piliexo_video_speed_transition {
+    double speed;
+    int64_t release_ns;
+    bool vo_recovered;
+};
+
+// 以实际减速开始计时，恢复到 1.25x 等基础倍速也进入同一过渡。
+static inline bool piliexo_video_speed_changed(struct piliexo_video_speed_transition *s,
+                                                double speed, int64_t now)
+{
+    if (s->speed == speed)
+        return false;
+    s->release_ns = s->speed > 1.01 && speed < s->speed ? now : 0;
+    s->vo_recovered = false;
+    s->speed = speed;
+    return s->release_ns > 0;
+}
+
+static inline bool piliexo_video_releasing(const struct piliexo_video_speed_transition *s,
+                                           int64_t now)
+{
+    return s->release_ns > 0 && now >= s->release_ns &&
+           now - s->release_ns < PILIEXO_RELEASE_NS;
+}
+
+static inline bool piliexo_release_can_drop(const struct piliexo_video_speed_transition *s,
+                                           int64_t now, bool dropped_output)
+{
+    return !dropped_output && piliexo_video_releasing(s, now);
+}
+
+// 先保留复速后的画面。音画靠近后恢复输出策略，避免普通时钟抖动重新触发保护。
+static inline bool piliexo_vo_recovery_can_drop(struct piliexo_video_speed_transition *s,
+                                               int64_t now, double av_difference)
+{
+    if (s->release_ns <= 0 || now < s->release_ns || s->vo_recovered)
+        return true;
+    int64_t elapsed = now - s->release_ns;
+    if (elapsed < PILIEXO_RELEASE_NS)
+        return false;
+    s->vo_recovered = elapsed >= PILIEXO_VO_RECOVERY_MAX_NS ||
+                      (av_difference >= -0.050 && av_difference <= 0.050);
+    return s->vo_recovered;
+}
+
+// 松手后保持接近基础送显节拍，给正常的调度抖动留出一成余量。
+static inline int64_t piliexo_release_output_pts(int64_t now, int64_t target,
+                                                 int64_t previous, double fps,
+                                                 double speed)
+{
+    if (!(fps > 20 && fps < 500 && speed > 0) || previous <= 0 ||
+        previous > now || now - previous >= PILIEXO_RELEASE_NS)
+        return target;
+    int64_t earliest = previous + (int64_t)(900000000.0 / (fps * speed));
+    return target < earliest ? earliest : target;
+}
+
+// 只在明显迟到时追赶；留出三个源帧或 80ms 的媒体时间容差。
+static inline bool piliexo_late_output_due(double audio_pts, double pts, double fps)
+{
+    return fps > 20 && fps < 500 && audio_pts - pts >= 0.080 &&
+           (audio_pts - pts) * fps >= 3;
+}
+
+// 保留尚未到呈现时刻的后继画面，拒绝倒序或跨时间戳断点替换。
+static inline bool piliexo_late_output_can_replace(double audio_pts, double pts,
+                                                   double next_pts)
+{
+    return next_pts > pts && next_pts - pts <= 0.125 && next_pts <= audio_pts;
+}
+
+#endif
