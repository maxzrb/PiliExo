+
+static double mediacodec_audio_deadline(struct MPContext *mpctx,
+                                      struct vo_chain *vo_c)
+{
+    if (mpctx->video_status != STATUS_PLAYING ||
+        mpctx->audio_status != STATUS_PLAYING || !mpctx->ao_chain ||
+        mpctx->ao_chain->ao_underrun || ao_untimed(mpctx->ao) ||
+        vo_c->vo->opts->video_sync == VS_NONE || mpctx->display_sync_active ||
+        mpctx->paused || mpctx->hrseek_active || mpctx->step_frames ||
+        mpctx->play_dir != 1 || vo_c->is_sparse ||
+        mpctx->video_pts == MP_NOPTS_VALUE ||
+        (mpctx->opts->playback_speed <= 1.01 &&
+         !piliexo_video_releasing(&vo_c->speed_transition, mp_time_ns())))
+        return MP_NOPTS_VALUE;
+
+    double audio_pts = playing_audio_pts(mpctx);
+    return audio_pts == MP_NOPTS_VALUE ? audio_pts : audio_pts + mpctx->opts->audio_delay;
+}
+
+static void update_live_decoder_framedrop(struct MPContext *mpctx,
+                                          struct vo_chain *vo_c)
+{
+    if (!vo_c->track || !vo_c->track->dec)
+        return;
+
+    int drops = 0;
+    double fps = vo_c->filter->container_fps;
+    double deadline = mediacodec_audio_deadline(mpctx, vo_c);
+    if (deadline != MP_NOPTS_VALUE &&
+        !piliexo_video_releasing(&vo_c->speed_transition, mp_time_ns()) &&
+        piliexo_late_output_due(deadline, mpctx->video_pts, fps))
+    {
+        // 解码器只跳过可独立安全丢弃的完整访问单元。
+        drops = MPCLAMP((deadline - mpctx->video_pts) * fps - 2, 0, 12);
+    }
+    // 不把上一次的丢帧需求留给无音频或已追上的窗口。
+    mp_decoder_wrapper_set_frame_drops(vo_c->track->dec, drops);
+}
