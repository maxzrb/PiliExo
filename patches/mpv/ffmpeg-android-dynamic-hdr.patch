+    int ret = AVERROR_EXTERNAL;
+    jclass bundle_class = (*env)->FindClass(env, "android/os/Bundle");
+    if (!bundle_class)
+        goto done;
+    jmethodID init = (*env)->GetMethodID(env, bundle_class, "<init>", "()V");
+    if (!init)
+        goto done;
+    jmethodID put_float = (*env)->GetMethodID(env, bundle_class, "putFloat",
+                                             "(Ljava/lang/String;F)V");
+    if (!put_float)
+        goto done;
+    jobject bundle = (*env)->NewObject(env, bundle_class, init);
+    if (!bundle)
+        goto done;
+    jstring key = (*env)->NewStringUTF(env, "operating-rate");
+    if (!key)
+        goto done;
+    (*env)->CallVoidMethod(env, bundle, put_float, key, (jfloat)rate);
+    if ((*env)->ExceptionCheck(env))
+        goto done;
+    (*env)->CallVoidMethod(env, codec->object, codec->jfields.set_parameters_id, bundle);
+    if (!(*env)->ExceptionCheck(env))
+        ret = 0;
+
+done:
+    ff_jni_exception_check(env, 1, codec);
+    (*env)->PopLocalFrame(env, NULL);
