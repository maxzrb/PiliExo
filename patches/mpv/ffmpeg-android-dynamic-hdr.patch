+static const uint8_t *piliexo_annexb_start_code(const uint8_t *p,
+                                                const uint8_t *end)
+{
+    while (end - p >= 3) {
+        if (p[0] == 0 && p[1] == 0) {
+            if (p[2] == 1)
+                return p;
+            if (end - p >= 4 && p[2] == 0 && p[3] == 1)
+                return p;
+        }
+        p++;
+    }
+    return NULL;
+}
+
+/*
+ * 判断一个 Annex B 访问单元是否只包含非参考画面。
+ *
+ * 调用方已确认当前迟到且有丢帧额度。只丢弃整个 AU，
+ * 避免把多 slice 画面拆坏；带参数集、关键帧或混合参考画面的
+ * AU 一律保留。
+ */
+static int piliexo_should_drop_nonref_au(AVCodecContext *avctx,
+                                         const AVPacket *pkt)
+{
+    const uint8_t *p;
+    const uint8_t *end;
+    const uint8_t *start;
+    int has_vcl = 0;
+    int has_ref = 0;
+    int has_config = 0;
+
+    if (avctx->codec_id != AV_CODEC_ID_H264 &&
+        avctx->codec_id != AV_CODEC_ID_HEVC)
+        return 0;
+    if (pkt->size <= 0 || (pkt->flags & AV_PKT_FLAG_KEY))
+        return 0;
+    if (av_packet_get_side_data(pkt, AV_PKT_DATA_NEW_EXTRADATA, NULL))
+        return 0;
+
+    p = pkt->data;
+    end = p + pkt->size;
+    start = piliexo_annexb_start_code(p, end);
+    if (!start)
+        return 0;
+
+    while (start && start < end) {
+        const uint8_t *nal = start;
+        const uint8_t *next;
+        const uint8_t *nal_end;
+        int sc_len = (end - start >= 4 &&
+                      start[2] == 0 && start[3] == 1) ? 4 : 3;
+        unsigned type;
+
+        nal += sc_len;
+        next = piliexo_annexb_start_code(nal, end);
+        nal_end = next ? next : end;
+        if (nal_end <= nal || (nal[0] & 0x80))
+            return 0;
+
+        if (avctx->codec_id == AV_CODEC_ID_HEVC) {
+            if (nal_end - nal < 2 || !(nal[1] & 7))
+                return 0;
+            type = (nal[0] >> 1) & 0x3f;
+            if (type >= 10 && type < 32)
+                return 0;
+            if (type <= 9) {
+                has_vcl = 1;
+                if (type & 1)
+                    has_ref = 1;
+            } else if (type >= 16 && type <= 23) {
+                has_vcl = 1;
+                has_ref = 1;
+            } else if (type == 32 || type == 33 || type == 34) {
+                has_config = 1;
+            }
+        } else {
+            type = nal[0] & 0x1f;
+            if (type == 1) {
+                has_vcl = 1;
+                if (nal[0] >> 5)
+                    has_ref = 1;
+            } else if (type != 9 && type != 12) {
+                // 参数集、分区/扩展片层和无法确认依赖关系的类型均保留。
+                return 0;
+            }
+        }
+        start = next;
+    }
+
+    if (!has_vcl || has_ref || has_config)
+        return 0;
+    return 1;
+}
