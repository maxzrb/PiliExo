+#ifndef AVCODEC_PILIEXO_DECODE_BUDGET_H
+#define AVCODEC_PILIEXO_DECODE_BUDGET_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct piliexo_decode_budget {
+    int demand;
+    int decoded;
+    int64_t sample_start_us;
+    double fraction;
+    double credit;
+};
+
+static inline void piliexo_decode_budget_measure(struct piliexo_decode_budget *b,
+                                                int demand, int64_t now_us,
+                                                bool late, bool decoded)
+{
+    if (demand != b->demand)
+        *b = (struct piliexo_decode_budget){.demand = demand};
+
+    if (!late || demand <= 0) {
+        b->sample_start_us = 0;
+        b->decoded = 0;
+        b->credit = 0;
+        return;
+    }
+
+    int64_t elapsed = now_us - b->sample_start_us;
+    if (!b->sample_start_us || elapsed < 0 || elapsed > 1000000) {
+        b->sample_start_us = now_us;
+        b->decoded = 0;
+        return;
+    }
+
+    b->decoded += decoded;
+    if (elapsed < 500000)
+        return;
+
+    // 有持续迟到反馈时才测容量。几乎没有输出的窗口可能是断供，不据此增加丢帧。
+    if (b->decoded >= 5) {
+        double capacity = b->decoded * 1000000.0 / elapsed;
+        b->fraction = capacity < demand ? 1 - capacity / demand : 0;
+    }
+    b->sample_start_us = now_us;
+    b->decoded = 0;
+}
+
+// 按所有输入帧累计额度。遇到参考帧只暂存额度，最多延期补偿两帧。
+static inline bool piliexo_decode_budget_due(struct piliexo_decode_budget *b)
+{
+    if (b->fraction <= 0)
+        return false;
+    b->credit += b->fraction;
+    if (b->credit > 2)
+        b->credit = 2;
+    return b->credit >= 1;
+}
+
+static inline void piliexo_decode_budget_drop(struct piliexo_decode_budget *b)
+{
+    b->credit -= 1;
+}
+
+#endif
